rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo público: cualquiera puede leer los productos, porque la tienda
    // es pública y se renderiza sin sesión. Crear, editar o borrar exige una
    // sesión autenticada del panel.
    match /productos/{productoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuración de la tienda (portada). La home la lee sin sesión, así que
    // la lectura es pública; escribir exige estar autenticado en el panel.
    match /configuracion/{documento} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Imágenes sueltas en base64, para cuando el catálogo necesite fotos de
    // producto. Se guardan aparte para que las consultas del catálogo no
    // arrastren el peso del base64 en cada documento.
    match /imagenes/{imagenId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Datos internos del negocio: solo usuarios autenticados.
    match /ventas/{ventaId} {
      allow read, write: if request.auth != null;
    }
    match /facturas/{facturaId} {
      allow read, write: if request.auth != null;
    }
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }
    match /lotes/{loteId} {
      allow read, write: if request.auth != null;
    }
    match /insumos/{insumoId} {
      allow read, write: if request.auth != null;
    }

    // Todo lo demás queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
