rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo la cuenta del panel (jabonesg79@gmail.com) escribe. Se compara el
    // UID y no el correo: el UID no cambia aunque se cambie el correo de la
    // cuenta. La creación de cuentas está apagada en Authentication, pero la
    // regla no depende de eso: aunque existiera otra cuenta, no podría tocar nada.
    function esAdmin() {
      return request.auth != null && request.auth.uid == "p4WbYsD6eIOhy5WGrX5MWAxRNAm2";
    }

    // Catálogo: la tienda lo lee sin sesión.
    match /productos/{productoId} {
      allow read: if true;
      allow write: if esAdmin();

      // Fotos de cada jabón, una por documento (versión grande + miniatura).
      // La ficha de la tienda las lee sin sesión.
      match /imagenes/{imagenId} {
        allow read: if true;
        allow write: if esAdmin();
      }
    }

    // Recorrido de cotización de eventos: tipos de evento y diseños (con sus
    // colores, aromas y precios). La tienda los lee sin sesión; solo el admin
    // los crea o cambia. Las fotos de cada diseño van una por documento, como
    // las de los jabones.
    match /tiposEvento/{tipoId} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /disenos/{disenoId} {
      allow read: if true;
      allow write: if esAdmin();

      match /imagenes/{imagenId} {
        allow read: if true;
        allow write: if esAdmin();
      }
    }

    // Configuración que pinta la tienda: portada (hero), contacto (WhatsApp e
    // Instagram), testimonios y eventos (precio desde, mínimo, anticipación y
    // empaques). Lectura pública solo de esos cuatro documentos.
    match /configuracion/{documento} {
      allow read: if documento in ["portada", "contacto", "testimonios", "eventos"] || esAdmin();
      allow write: if esAdmin();
    }

    // Solicitudes de cotización de eventos. Hoy la tienda cotiza por WhatsApp y
    // no guarda nada aquí; la regla queda lista por si se agrega un formulario.
    // El público solo puede crear una solicitud, con campos y largos acotados
    // para que no se pueda usar la colección como almacenamiento libre. Solo el
    // admin las lee, edita o borra.
    match /cotizaciones/{cotizacionId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ["nombre", "telefono", "evento", "fecha", "cantidad", "mensaje", "creado"])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.telefono is string
                    && request.resource.data.telefono.size() > 0
                    && request.resource.data.telefono.size() <= 30
                    && (!("evento" in request.resource.data)
                        || (request.resource.data.evento is string
                            && request.resource.data.evento.size() <= 60))
                    && (!("fecha" in request.resource.data)
                        || (request.resource.data.fecha is string
                            && request.resource.data.fecha.size() <= 30))
                    && (!("cantidad" in request.resource.data)
                        || (request.resource.data.cantidad is int
                            && request.resource.data.cantidad > 0
                            && request.resource.data.cantidad <= 10000))
                    && (!("mensaje" in request.resource.data)
                        || (request.resource.data.mensaje is string
                            && request.resource.data.mensaje.size() <= 1000))
                    && (!("creado" in request.resource.data)
                        || request.resource.data.creado == request.time);
      allow read, update, delete: if esAdmin();
    }

    // Pedidos enviados desde el carrito de la tienda. El público solo crea, con
    // campos y largos acotados; el estado arranca siempre en "nuevo" y la fecha
    // la pone el servidor. Las reglas no revisan cada línea por dentro: el
    // panel recalcula stock y precios desde los productos al convertir el
    // pedido en venta, y nunca usa el total que manda el navegador.
    match /pedidosWeb/{pedidoId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ["lineas", "total", "nombre", "telefono", "ciudad", "entrega", "notas",
                          "estado", "creado"])
                    && request.resource.data.keys().hasAll(
                         ["lineas", "total", "nombre", "telefono", "ciudad", "entrega", "notas",
                          "estado", "creado"])
                    && request.resource.data.lineas is list
                    && request.resource.data.lineas.size() > 0
                    && request.resource.data.lineas.size() <= 20
                    && request.resource.data.total is int
                    && request.resource.data.total >= 0
                    && request.resource.data.total <= 100000000
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.telefono is string
                    && request.resource.data.telefono.size() <= 30
                    && request.resource.data.ciudad is string
                    && request.resource.data.ciudad.size() <= 60
                    && request.resource.data.entrega in ["", "Envío a domicilio", "Recoger en tienda"]
                    && request.resource.data.notas is string
                    && request.resource.data.notas.size() <= 500
                    && request.resource.data.estado == "nuevo"
                    && request.resource.data.creado == request.time;
      allow read, update, delete: if esAdmin();
    }

    // Pedidos de recordatorios para eventos, con datos del cliente y abonos:
    // solo el admin.
    match /eventos/{pedidoId} {
      allow read, write: if esAdmin();
    }

    // Datos internos del negocio: solo el admin.
    match /ventas/{ventaId} {
      allow read, write: if esAdmin();
    }
    match /facturas/{facturaId} {
      allow read, write: if esAdmin();
    }
    match /clientes/{clienteId} {
      allow read, write: if esAdmin();
    }
    match /lotes/{loteId} {
      allow read, write: if esAdmin();
    }
    match /insumos/{insumoId} {
      allow read, write: if esAdmin();
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
